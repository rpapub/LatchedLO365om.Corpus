# environments/corporate-m365.env.example
# Environment variables for corpus setup against a corporate Microsoft 365 account.
# (work/school accounts — Entra ID / Azure AD tenant)
#
# Copy to .env and fill in your values. Never commit .env.

# ── Authentication ─────────────────────────────────────────────────────────────

# App registration client ID — registered in your organisation's Entra ID tenant.
# Required permissions: Mail.ReadWrite (delegated)
# Admin consent may be required depending on tenant policy.
CORPUS_CLIENT_ID=<your-app-registration-client-id>

# Your organisation's Entra ID tenant ID (GUID or primary domain).
CORPUS_TENANT_ID=<your-tenant-id-or-domain.onmicrosoft.com>

# ── Mailbox ────────────────────────────────────────────────────────────────────

# The shared/test mailbox where corpus messages are created.
# Use a dedicated test mailbox — corpus setup clears the target folder on each run.
CORPUS_MAILBOX=corpus-test@yourdomain.com

# ── Future: Orchestrator Assets (CI/CD) ───────────────────────────────────────
# When running from UiPath Orchestrator / GitHub Actions, inject these as:
#   - Orchestrator Assets (named by the env var name)
#   - GitHub Actions secrets (CORPUS_TOKEN for token passthrough)
#
# CORPUS_TOKEN=<pre-obtained bearer token>   # alternative to client-id + tenant-id
