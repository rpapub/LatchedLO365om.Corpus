# environments/personal-hotmail.env.example
# Environment variables for corpus setup against a personal Microsoft account
# (@hotmail.com, @outlook.com, @live.com).
#
# Copy to .env and fill in your values. Never commit .env.
# Load with: export $(cat .env | xargs)
# Or use:    python-dotenv, direnv, etc.

# ── Authentication ─────────────────────────────────────────────────────────────

# App registration client ID — public client, no secret needed.
# Safe to commit. Create at: https://portal.azure.com → App registrations
# Required permissions: Mail.ReadWrite (delegated, user consent)
# Platform: Mobile and desktop applications, redirect URI: http://localhost
CORPUS_CLIENT_ID=c44051af-0358-4845-aac1-0d83741dca16

# Tenant for personal accounts — do not change.
CORPUS_TENANT_ID=consumers

# Auth mode for the CLI: device (recommended for WSL/headless), interactive, or token.
# CORPUS_AUTH=device

# ── Mailbox ────────────────────────────────────────────────────────────────────

# The mailbox where corpus messages are created.
CORPUS_MAILBOX=you@hotmail.com
